{
  "name": "@local/dsh-gstack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "gstack super team for DeepSeek Harness: preset, agent teams, sprint workflow, evidence, freeze guard, browser and a live sprint panel.",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "exports": {
    "./client": "./sprint-live/client.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soeluc/dsh-gstack.git"
  },
  "homepage": "https://github.com/soeluc/dsh-gstack#readme",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "render": "node render.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "gstack",
    "agent-teams",
    "skills",
    "agent-preset"
  ]
}
